# PyInstaller собирает бинарь только на CPython с --enable-shared: интерпретаторы
# образов manylinux слинкованы статически и libpython не отдают. python3.11
# из репозиториев AlmaLinux 8 — shared, а glibc базового образа (2.28) остаётся
# нижней границей совместимости собранного бинаря.
# Те же шаги воспроизводит job сборки в .gitlab-ci.yml — правки парой.
FROM almalinux:8

LABEL maintainer="vladislav.orlov"
LABEL email="vladislav.orlov@itglobal.com"

# poetry 1.8 читает формат poetry.lock репозитория
ENV POETRY_VERSION="1.8.*"

WORKDIR /code

RUN dnf -y install python3.11 python3.11-pip && dnf clean all
RUN python3.11 -m pip install --no-cache-dir "poetry==$POETRY_VERSION"

CMD [ "bash", "bundle/build_linux.sh" ]
