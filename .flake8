[flake8]
max-line-length=120
max-arguments = 6

# W503 конфликтует с W504: стиль репозитория переносит бинарный оператор в начало строки
ignore =
    W503,

# Модуль команд описывает команду декораторами click и параметрами колбэка, поэтому число
# декораторов (WPS216), аргументов (WPS211), членов модуля (WPS202) и повторов выражений
# и строк (WPS204, WPS226) здесь задаётся составом команд CLI, а не сложностью кода.
# WPS463: имя колбэка — это имя команды, и команды `get-*` печатают результат, а не возвращают его;
# переименование сломало бы обратную совместимость CLI.
# WPS235/WPS412: `s2ctl/__init__.py` регистрирует группы команд импортом — без этого они не попадают в бинарь.
# WPS201 в `s2ctl/cmd_server.py`: раздел `server` — самый большой в CLI, и число
# импортов задано числом типов контракта, которые принимают его команды.
# WPS202 в `s2ctl/params.py`: модуль границы click держит по колбэку на каждый тип
# идентификатора контракта — число членов задано числом типов, а не сложностью кода.
# WPS202 в `ssclient/domain/record_entities.py`: по `TypedDict` на каждый тип записи DNS —
# число членов задано словарём контракта, а не сложностью кода.
# `tools/dump_contract_operations.py` — построчный разбор исходников publisher'а
# регулярными выражениями: число членов модуля (WPS202) и локальных переменных (WPS210),
# сложность строки (WPS221), повтор литерала (WPS226), сборка регулярного выражения
# конкатенацией (WPS336, WPS342), таблица глаголов HTTP модульной константой (WPS407)
# и поиск константы по двум именам (WPS529) заданы формой разбираемого текста.
per-file-ignores =
    src/s2ctl/__init__.py: WPS235, WPS412
    src/s2ctl/click.py: WPS202
    src/s2ctl/cmd_affinity_group.py: WPS216
    src/s2ctl/cmd_ansible.py: WPS463
    src/s2ctl/cmd_domain.py: WPS202, WPS204, WPS211, WPS216, WPS226, WPS463
    src/s2ctl/cmd_gateway.py: WPS202, WPS204, WPS216, WPS226, WPS463
    src/s2ctl/cmd_metainfo.py: WPS216
    src/s2ctl/cmd_network.py: WPS202, WPS211, WPS216, WPS226
    src/s2ctl/params.py: WPS202
    src/s2ctl/cmd_server.py: WPS201, WPS202, WPS204, WPS211, WPS216, WPS226, WPS463
    src/s2ctl/cmd_sshkey.py: WPS216
    src/s2ctl/cmd_vmware.py: WPS202, WPS204, WPS211, WPS216, WPS226, WPS463
    src/s2ctl/cmd_vmware_server.py: WPS202, WPS204, WPS211, WPS216, WPS226, WPS463
    src/ssclient/domain/record_entities.py: WPS202
    tools/dump_contract_operations.py: WPS202, WPS210, WPS221, WPS226, WPS336, WPS342, WPS407, WPS529

exclude =
    .git,
    __pycache__,
    .tox,
    tests,
    bundle,
